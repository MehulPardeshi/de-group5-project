# Copy this file to .env (cp .env.example .env). Never commit .env.

# Local PostgreSQL (docker compose). Pick any password: it only exists on your laptop.
PGHOST=localhost
PGPORT=5432
PGDATABASE=de_group5
PGUSER=de
PGPASSWORD=change-me

# Shared MongoDB Atlas (for the NOAA JSON). Mehul sends this privately.
MONGODB_URI=

# NOAA Climate Data Online token (Yang): https://www.ncei.noaa.gov/cdo-web/token
NOAA_TOKEN=
